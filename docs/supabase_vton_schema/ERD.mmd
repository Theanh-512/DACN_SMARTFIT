    PROFILES {
      uuid id PK
      text full_name
      text phone
      text avatar_path
    }
    CATEGORIES {
      uuid id PK
      uuid parent_id FK
      text name
      text slug UK
      boolean is_active
    }
    PRODUCTS {
      uuid id PK
      uuid category_id FK
      text name
      text slug UK
      numeric base_price
      text status
    }
    PRODUCT_VARIANTS {
      uuid id PK
      uuid product_id FK
      text sku UK
      text size
      text color
      numeric price_override
      int stock_quantity
      int reserved_quantity
    }
    ORDERS {
      uuid id PK
      bigint order_number UK
      uuid user_id FK
      numeric subtotal_amount
      numeric shipping_fee
      numeric total_amount
      text status
      timestamptz reservation_expires_at
      uuid idempotency_key
    }
    ORDER_ITEMS {
      uuid id PK
      uuid order_id FK
      uuid product_variant_id FK
      text product_name_snapshot
      numeric unit_price
      int quantity
      numeric line_total
    }
    PAYMENTS {
      uuid id PK
      uuid order_id FK
      text provider
      text status
      numeric amount
      text provider_transaction_id
    }
    TRY_ON_JOBS {
      uuid id PK
      uuid user_id FK
      uuid product_variant_id FK
      text input_image_path
      text garment_image_path
      text output_image_path
      text status
      text model_version
    }
