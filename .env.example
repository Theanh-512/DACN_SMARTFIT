# ==========================================
# FASHION AI E-COMMERCE CONFIGURATION
# ==========================================

# Database (SQL Server)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DB=FashionAIDb
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=YourStrongPassword123!
DATABASE_CONNECTION_STRING=Server=localhost,1433;Database=FashionAIDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;

# JWT Authentication
JWT_SECRET=fashion_ai_ecommerce_super_secret_jwt_key_2026_at_least_32_chars!
JWT_ISSUER=FashionAI
JWT_AUDIENCE=FashionAIApp
JWT_EXPIRATION_MINUTES=1440

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=fashion_ai_internal_secret_token_2026

# Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BUCKET=fashion-catalog-public
STORAGE_PRIVATE_BUCKET=fashion-user-biometrics-private

# Redis Cache
REDIS_CONNECTION_STRING=localhost:6379

# Client URL (CORS)
CLIENT_URL=http://localhost:4200
